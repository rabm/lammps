# Only the positive-x rank owns the rotating octahedron's body.
# The negative-x rank computes five atom velocities from its ghost body.
units lj
atom_style molecular
processors 2 1 1
region box block -6 6 -6 6 -6 6
create_box 1 box
create_atoms 1 single  0.95  0  0
create_atoms 1 single -1.05  0  0
create_atoms 1 single -0.05  1  0
create_atoms 1 single -0.05 -1  0
create_atoms 1 single -0.05  0  1
create_atoms 1 single -0.05  0 -1
mass 1 1
set group all mol 1
pair_style zero 1.0
pair_coeff * *
comm_modify cutoff 3.0
fix bodies all rigid/small molecule reinit yes

# Each velocity field is already rigid, so setup must preserve it on both ranks.
variable spin index 0.3 -0.7
label field
variable vx atom 2.0-(${spin})*y
variable vy atom ${spin}*x
velocity all set v_vx v_vy 0 units box
variable err atom abs(vx-v_vx)+abs(vy-v_vy)+abs(vz)
compute maxerr all reduce max v_err
thermo_style custom step temp c_maxerr
run 0
if "$(c_maxerr:%.17g) > 1.0e-12" then "quit 1"
uncompute maxerr
next spin
jump SELF field
